{
  "expo": {
    "name": "Dough & Ferment",
    "slug": "sourdough-optimizer",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sourdough",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF5ED",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sourdough.optimizer",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF5ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "baseUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF5ED",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1A1412"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Dough & Ferment to use your location to detect local temperature and water hardness for accurate baking guidance. Your coordinates are sent to Open-Meteo (weather) and OpenStreetMap (geocoding)."
        }
      ],
      "./plugins/withAndroidSigningConfig"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}