{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sourdough-redcard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "POLL_INTERVAL_SECONDS": "1200", "DAILY_REQUEST_LIMIT": "85" },
  "durable_objects": { "bindings": [{ "name": "LIVE_STATE", "class_name": "RedCardState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RedCardState"] }]
}
