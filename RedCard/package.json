{
  "name": "sourdough-redcard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "worker:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:dev": "wrangler dev --config wrangler.jsonc"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4",
    "@cloudflare/workers-types": "5.20261003.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
